{
  "name": "boo-notes-desktop",
  "productName": "Boo Notes",
  "version": "0.1.0",
  "private": true,
  "description": "Boo Notes Desktop — bibliothèque de cours, lecteur PDF / audio / vidéo annoté et synchronisation Notion.",
  "author": "Boo Notes",
  "license": "UNLICENSED",
  "main": "dist/main.cjs",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:ui": "npm run build && playwright test",
    "icons": "node scripts/make-ico.mjs",
    "mock:notion": "node tools/mock-notion.mjs",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "1.56.1",
    "@types/d3-force": "^3.0.10",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@xyflow/react": "^12.11.6",
    "d3-force": "^3.0.0",
    "d3-hierarchy": "^3.1.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "hls.js": "^1.7.3",
    "motion": "^13.4.2",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "ws": "^8.21.3",
    "zustand": "^5.0.15"
  }
}
