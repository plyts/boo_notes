{
  "manifest_version": 3,
  "name": "Boo Notes",
  "short_name": "Boo Notes",
  "version": "0.0.0",
  "description": "Notes horodatées, citations liées et captures au clavier sur toute vidéo ou tout audio du web — YouTube, Udemy, Coursera, Notion, lecteurs intégrés, podcasts, radios — et sur tout article, synchronisées avec Notion.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Boo Notes — ouvrir / réduire les notes (active Boo Notes sur ce site)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "downloads",
    "alarms",
    "clipboardWrite",
    "offscreen"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.udemy.com/*",
    "*://*.coursera.org/*",
    "*://*.notion.so/*",
    "*://*.notion.site/*",
    "https://api.notion.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.udemy.com/*",
        "*://*.coursera.org/*",
        "*://*.notion.so/*",
        "*://*.notion.site/*"
      ],
      "js": [
        "media-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.udemy.com/*",
        "*://*.coursera.org/*",
        "*://*.notion.so/*",
        "*://*.notion.site/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.udemy.com/*",
        "*://*.coursera.org/*",
        "*://*.notion.so/*",
        "*://*.notion.site/*"
      ],
      "js": [
        "frame.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "panel/panel.html",
        "panel/panel.js",
        "panel/editor.css",
        "panel/panel.css",
        "panel/transcript.css",
        "tokens.css",
        "fonts/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-sidebar": {
      "suggested_key": {
        "default": "Alt+Shift+N"
      },
      "description": "Ouvrir / réduire le panneau de notes"
    },
    "insert-timestamp": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Horodater la note (vidéo) · citer le passage sélectionné (page)"
    },
    "capture-screenshot": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Capturer l’image de la vidéo ou de la page"
    },
    "smart-pause": {
      "suggested_key": {
        "default": "Alt+Shift+Space"
      },
      "description": "Mettre en pause et écrire (Smart Pause)"
    },
    "replay": {
      "description": "Reculer de 5 secondes (Alt+← dans la page par défaut)"
    },
    "passage-start": {
      "description": "Début du passage (Alt+I dans la page par défaut)"
    },
    "passage-end": {
      "description": "Fin du passage : extrait avec ses sous-titres et vos notes (Alt+O dans la page par défaut)"
    }
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
